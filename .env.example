# NovaCart Intelligence Layer — Environment Variables

# Required: API Key for /chat and /documents/upload endpoints
# Choose any secret string for demo
API_KEY=your-demo-api-key-here

# Required: OpenRouter API Key
# Get free tier at https://openrouter.ai
# Format: sk-or-v1-...
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Vector Store Configuration
# Chroma persists to SQLite at this path
CHROMA_PERSIST_DIRECTORY=./chroma_data

# Application Settings
DEBUG=False
